# --- Dati grezzi e cache ---------------------------------------------------
# I file EAGLE-I annuali e le cache meteo sono grossi e ricostruibili
# dagli script in code/data_acquisition/. Mai versionarli.
data/*
!data/.gitkeep
# The one exception. training_counties.csv is not a derived artifact in practice: the
# archived forecast set under data/raw was downloaded for exactly these counties, at a
# rate limit that makes re-downloading a different sample a multi-day operation. Leaving
# it unversioned let a clean checkout re-derive a different sample and train on 59 of
# the 102 counties without a single error (see build_training_table.py). It is an input.
!data/processed/
data/processed/*
!data/processed/training_counties.csv
outputs/
*.parquet
*.feather

# Generated prediction artifacts. submission/predictions.csv (the real deliverable)
# IS committed; smoke-test output is regenerated on demand and only adds churn.
submission/predictions_smoke_test.csv

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Segreti ---------------------------------------------------------------
.env
*.key
secrets.*

# --- Sistema ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Editor ----------------------------------------------------------------
.vscode/
.idea/
